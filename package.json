{
  "name": "vscode-svn-tools",
  "displayName": "SVN Tools",
  "description": "SVN Source Control panel, explorer context menu (SVN / TortoiseSVN) and status decorations including ignored files.",
  "version": "0.7.0",
  "publisher": "khoon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pugi-kh/vscode-svn-tools.git"
  },
  "bugs": {
    "url": "https://github.com/pugi-kh/vscode-svn-tools/issues"
  },
  "homepage": "https://github.com/pugi-kh/vscode-svn-tools#readme",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "manifest": "node manifest.js",
    "test": "node test/svn-paths.js",
    "package": "node manifest.js && npx --yes @vscode/vsce package"
  },
  "contributes": {
    "commands": [
      {
        "command": "svnTools.refresh",
        "title": "Refresh",
        "category": "SVN",
        "icon": "$(refresh)"
      },
      {
        "command": "svnTools.commitAll",
        "title": "Commit",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "svnTools.commit",
        "title": "Commit…",
        "category": "SVN"
      },
      {
        "command": "svnTools.update",
        "title": "Update",
        "category": "SVN",
        "icon": "$(arrow-down)"
      },
      {
        "command": "svnTools.diff",
        "title": "Compare with BASE",
        "category": "SVN",
        "icon": "$(diff)"
      },
      {
        "command": "svnTools.openFile",
        "title": "Open File",
        "category": "SVN",
        "icon": "$(go-to-file)"
      },
      {
        "command": "svnTools.revert",
        "title": "Revert",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "svnTools.revertAll",
        "title": "Revert All",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "svnTools.add",
        "title": "Add",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "svnTools.addAll",
        "title": "Add All",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "svnTools.delete",
        "title": "Delete",
        "category": "SVN"
      },
      {
        "command": "svnTools.rename",
        "title": "Rename (keep history)",
        "category": "SVN"
      },
      {
        "command": "svnTools.ignore",
        "title": "Add to Ignore List…",
        "category": "SVN"
      },
      {
        "command": "svnTools.ignoreReason",
        "title": "Show Ignore Reason…",
        "category": "SVN"
      },
      {
        "command": "svnTools.editIgnores",
        "title": "Edit Ignore Lists…",
        "category": "SVN",
        "icon": "$(eye-closed)"
      },
      {
        "command": "svnTools.log",
        "title": "Show Log",
        "category": "SVN",
        "icon": "$(history)"
      },
      {
        "command": "svnTools.resolve",
        "title": "Resolve Conflict…",
        "category": "SVN"
      },
      {
        "command": "svnTools.cleanup",
        "title": "Clean Up",
        "category": "SVN"
      },
      {
        "command": "svnTools.copyUrl",
        "title": "Copy SVN URL",
        "category": "SVN"
      },
      {
        "command": "svnTools.tortoise.update",
        "title": "Update",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.commit",
        "title": "Commit",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.log",
        "title": "Show Log",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.diff",
        "title": "Diff",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.revisiongraph",
        "title": "Revision Graph",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.repobrowser",
        "title": "Repo-browser",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.blame",
        "title": "Blame",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.add",
        "title": "Add",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.remove",
        "title": "Delete",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.rename",
        "title": "Rename",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.revert",
        "title": "Revert",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.conflicteditor",
        "title": "Edit Conflicts",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.resolve",
        "title": "Resolved",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.ignore",
        "title": "Add to Ignore List",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.properties",
        "title": "Properties",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.merge",
        "title": "Merge",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.switch",
        "title": "Switch",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.lock",
        "title": "Get Lock",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.unlock",
        "title": "Release Lock",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.cleanup",
        "title": "Clean Up",
        "category": "TortoiseSVN"
      },
      {
        "command": "svnTools.tortoise.settings",
        "title": "Settings",
        "category": "TortoiseSVN"
      }
